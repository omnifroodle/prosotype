# Environments and model caches (multi-GB, local only)
.venv/
.hf-cache/
__pycache__/
*.pyc
.DS_Store

# Audio stays local: the owner's voice recordings are not published
*.m4a
*.wav
*.aiff
*.mp3

# Generated
*.prs
!vectors/expected/*.prs
prototype/samples/**/*.html

# Downloaded during setup (see prototype/README.md)
prototype/fonts/*.ttf
prototype/data/cmudict.dict

# uv cache kept on the project drive
.uv-cache/

# Resynthesised audio and its round-trip transcriptions (contain or derive from the owner's voice)
prototype/samples/resynth/

# Licensed corpora and per-phone timing detail derived from them (not redistributable)
data/buckeye/
data/timit/
.timing-local/

# Montreal Forced Aligner environment, package cache and models (about 2 GB)
.mfa/
